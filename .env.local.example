# ─── Claude / Anthropic ───────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Gmail OAuth 2.0 ──────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com/ and enable the Gmail API.
# Then create OAuth 2.0 credentials (type: Web application).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# A long-lived refresh token obtained via the OAuth consent flow.
# You can generate one using the OAuth 2.0 Playground (https://developers.google.com/oauthplayground)
# with the https://www.googleapis.com/auth/gmail.readonly scope.
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Optional – the redirect URI registered for your OAuth app (defaults to http://localhost:3000)
# GOOGLE_REDIRECT_URI=http://localhost:3000
